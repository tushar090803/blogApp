<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Blogify</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <!-- Always visible -->
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
        </li>

        <% if (locals.user) { %>
          <!-- Show when user is logged in -->
          <li class="nav-item">
            <a class="nav-link" href="/blog/add-new">Add Blogs</a>
          </li>

          <!-- Show username -->
          <li class="nav-item d-flex align-items-center px-2">
            <span class="navbar-text fw-semibold">
              Hello, <%= locals.user.fullName || "User" %>
            </span>
          </li>

          <!-- Logout -->
          <li class="nav-item">
            <a class="nav-link text-danger fw-semibold" href="/user/logout">Log Out</a>
          </li>
        <% } else { %>
          <!-- Show when user is not logged in -->
          <li class="nav-item">
            <a class="nav-link" href="/user/signin">Sign In</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/user/signup">Sign Up</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

