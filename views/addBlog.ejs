<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Add New Blog</title>
</head>
<body>
    <%- include('./partials/nav') %>
    
    <div class="container mt-3">
        <form action="/blog/add-new" method="post">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text"
                class="form-control"
                id="title"
                name="title"
                aria-describedby="title"
                required
                />
            </div>
            <div class="mb-3">
                <label for="body">Body</label>
                <textarea
                class="form-control"
                id="body"
                name="body"
                required
                /></textarea>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>


    <%- include('./partials/scripts') %>
</body>
</html>